---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import { getMyChild, getTasks, getRewards } from '@/lib/api';
import { requireChild } from '@/lib/auth';
import type { Child, Reward, Task } from '@/lib/types';

/**
 * Dashboard da criança: mostra seu perfil (pontos), as missões pendentes
 * e um atalho para as recompensas que ela pode resgatar.
 */
const session = await requireChild(Astro);
const { user, cookie } = session;

let me: Child | null = null;
let tasks: Task[] = [];
let rewards: Reward[] = [];
try {
  [me, tasks, rewards] = await Promise.all([
    getMyChild(cookie),
    getTasks(cookie).catch((): Task[] => []),
    getRewards(cookie).catch((): Reward[] => []),
  ]);
} catch (error) {
  console.error('Não foi possível carregar o painel da criança:', error);
}

const pending = tasks.filter((t) => t.status === 'pending' || t.status === 'in_progress');
const available = rewards.filter((r) => !r.redeemedById);
const today = new Date().toISOString().slice(0, 10);
const todays = pending.filter((t) => t.scheduledDate <= today);
---

<BaseLayout title="Minhas Missões - Zapt">
  <div id="main-content" class="min-h-screen bg-surface">
    <Header user={user} />

    <main class="container mx-auto px-4 py-6 md:py-10 max-w-3xl">
      {/* Card de perfil */}
      <section class="bg-gradient-to-br from-primary to-primary-dark text-white rounded-2xl shadow-xl p-6 mb-6 flex items-center gap-4">
        <div class="w-20 h-20 rounded-full bg-white/20 flex items-center justify-center overflow-hidden flex-shrink-0 border-4 border-white/30">
          {me?.avatar ? (
            <img src={me.avatar} alt={me.name} class="w-full h-full object-cover" />
          ) : (
            <span class="text-4xl">🧒</span>
          )}
        </div>
        <div class="min-w-0">
          <p class="text-surface-light text-sm">Olá,</p>
          <h1 class="text-2xl md:text-3xl font-bold truncate">{me?.name ?? user.fullName}</h1>
          <p class="text-highlight font-bold text-lg mt-1">⭐ {me?.points ?? 0} pontos</p>
        </div>
      </section>

      {/* Atalhos */}
      <section class="grid grid-cols-2 gap-3 md:gap-4 mb-6">
        <a href="/crianca/missoes" class="bg-action hover:bg-action-dark text-white rounded-xl p-4 shadow-md transition-colors flex flex-col gap-1">
          <span class="text-2xl">🎯</span>
          <span class="font-semibold">Minhas Missões</span>
          <span class="text-xs text-white/80">{pending.length} ativa(s)</span>
        </a>
        <a href="/crianca/recompensas" class="bg-highlight hover:bg-highlight-dark text-primary-dark rounded-xl p-4 shadow-md transition-colors flex flex-col gap-1">
          <span class="text-2xl">🎁</span>
          <span class="font-semibold">Recompensas</span>
          <span class="text-xs text-primary-dark/70">{available.length} disponível(is)</span>
        </a>
      </section>

      {/* Missões de hoje */}
      <section>
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-lg md:text-xl font-bold text-primary">Missões de hoje</h2>
          <a href="/crianca/missoes" class="text-sm text-primary hover:underline">ver todas</a>
        </div>

        {todays.length === 0 ? (
          <div class="bg-white rounded-xl shadow-md p-8 text-center">
            <p class="text-3xl mb-2">🌟</p>
            <p class="text-gray-600">Tudo em dia! Nenhuma missão para hoje.</p>
          </div>
        ) : (
          <ul class="space-y-3">
            {todays.slice(0, 4).map((t) => (
              <li class="bg-white rounded-xl shadow-md p-4 flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <h3 class="font-bold text-primary-dark truncate">{t.title}</h3>
                  <p class="text-xs text-gray-500">🕐 {t.scheduledTime} · ⭐ +{t.rewardPoints} pts</p>
                </div>
                <a href="/crianca/missoes" class="text-sm font-medium text-action hover:underline whitespace-nowrap">
                  Fazer →
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    </main>

    <footer class="bg-primary-dark text-white py-6 mt-auto">
      <div class="container mx-auto px-4 text-center">
        <p class="text-sm text-surface-light">© 2026 Zapt</p>
      </div>
    </footer>
  </div>
</BaseLayout>
