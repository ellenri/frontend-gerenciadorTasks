---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import { getMyChild, getRewards } from '@/lib/api';
import { requireChild } from '@/lib/auth';
import type { Child, Reward } from '@/lib/types';

/**
 * Vitrine de recompensas da criança (o "ranking de prêmios").
 * Mostra os prêmios que o responsável criou e que ela pode resgatar com seus pontos.
 */
const session = await requireChild(Astro);
if(typeof session ==='string') return Astro.redirect(session);
const { user, cookie } = session;

let me: Child | null = null;
let rewards: Reward[] = [];
try {
  [me, rewards] = await Promise.all([
    getMyChild(cookie).catch(() => null),
    getRewards(cookie).catch((): Reward[] => []),
  ]);
} catch (error) {
  console.error('Não foi possível carregar as recompensas:', error);
}

const myPoints = me?.points ?? 0;
const available = rewards.filter((r) => !r.redeemedById);
const mine = rewards.filter((r) => r.redeemedById === me?.id);

// O id do perfil da criança (necessário no resgate).
const myChildId = me?.id ?? '';
---

<BaseLayout title="Recompensas - Zapt">
  <div id="main-content" class="min-h-screen bg-surface">
    <Header user={user} />

    <main class="container mx-auto px-4 py-6 md:py-10 max-w-4xl" data-child-id={myChildId}>
      <div class="mb-6">
        <h1 class="text-2xl md:text-3xl font-bold text-primary mb-1">🎁 Recompensas</h1>
        <p class="text-gray-600 text-sm md:text-base">Troque seus pontos por prêmios!</p>
        <p class="text-secondary-dark font-bold text-lg mt-1">Você tem ⭐ {myPoints} pontos</p>
      </div>

      <section class="mb-8">
        {available.length === 0 ? (
          <div class="bg-white rounded-xl shadow-md p-8 text-center text-gray-600">
            Nenhuma recompensa disponível ainda. Complete missões para ganhar pontos!
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {available.map((r) => {
              const canAfford = myPoints >= r.requiredPoints;
              return (
                <article class="bg-white rounded-xl shadow-md p-5 flex flex-col">
                  <h3 class="text-lg font-bold text-primary-dark">{r.title}</h3>
                  {r.description && <p class="text-sm text-gray-600 mt-1 flex-1">{r.description}</p>}
                  <div class="mt-4 flex items-center justify-between">
                    <span class="font-bold text-secondary-dark">⭐ {r.requiredPoints} pts</span>
                    <button
                      type="button"
                      class="resgatar-btn px-4 py-2 font-semibold rounded-lg text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                      class:list={[
                        canAfford
                          ? 'bg-highlight hover:bg-highlight-dark text-primary-dark'
                          : 'bg-gray-200 text-gray-400 cursor-not-allowed',
                      ]}
                      data-id={r.id}
                      data-cost={r.requiredPoints}
                      disabled={!canAfford}
                    >
                      {canAfford ? 'Resgatar' : 'Pontos insuf.'}
                    </button>
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </section>

      {mine.length > 0 && (
        <section>
          <h2 class="text-lg font-bold text-primary mb-3">Minhas recompensas resgatadas</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {mine.map((r) => (
              <article class="bg-white/60 rounded-xl shadow p-5 flex flex-col opacity-80">
                <h3 class="text-lg font-bold text-primary-dark">✅ {r.title}</h3>
                {r.description && <p class="text-sm text-gray-600 mt-1">{r.description}</p>}
                <span class="mt-3 text-xs text-gray-500">Resgatada</span>
              </article>
            ))}
          </div>
        </section>
      )}
    </main>

    <footer class="bg-primary-dark text-white py-6 mt-auto">
      <div class="container mx-auto px-4 text-center">
        <p class="text-sm text-surface-light">© 2026 Zapt</p>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  import { redeemReward, ApiError } from '../../lib/api';

  const myChildId = document.querySelector('main[data-child-id]')?.getAttribute('data-child-id') ?? '';

  document.querySelectorAll<HTMLButtonElement>('.resgatar-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      if (!id) return;
      if (!myChildId) {
        alert('Não foi possível identificar seu perfil.');
        return;
      }
      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Resgatando...';
      try {
        await redeemReward(id, myChildId);
        window.location.reload();
      } catch (error) {
        const message = error instanceof ApiError ? error.message : 'Não foi possível resgatar.';
        alert(message);
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  });
</script>
