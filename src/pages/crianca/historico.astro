---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import HistoryView from '@/components/history/HistoryView.astro';
import { getMyChild, getTasks } from '@/lib/api';
import { requireChild } from '@/lib/auth';
import {
  filterInWindow,
  computeStreak,
  getWindow,
  groupByDay,
  normalizeOffset,
  normalizePeriod,
  summarize,
  windowTitle,
} from '@/lib/history';
import type { Child, Task } from '@/lib/types';

/**
 * Histórico da criança: suas missões concluídas (com pontos) e canceladas,
 * organizadas por período (padrão: hoje — gratificação imediata).
 */
const session = await requireChild(Astro);
if (typeof session === 'string') return Astro.redirect(session);
if(typeof session ==='string') return Astro.redirect(session);
const { user, cookie } = session;

let me: Child | null = null;
let tasks: Task[] = [];
try {
  [me, tasks] = await Promise.all([
    getMyChild(cookie).catch(() => null),
    getTasks(cookie).catch((): Task[] => []),
  ]);
} catch (error) {
  console.error('Não foi possível carregar o histórico:', error);
}

const history = tasks.filter(
  (t) => t.status === 'completed' || t.status === 'skipped',
);

const period = normalizePeriod(Astro.url.searchParams.get('periodo'), 'Child');
const offset = normalizeOffset(Astro.url.searchParams.get('offset'));

const window = getWindow(period, offset);
const inWindow = filterInWindow(history, window);
const summary = { ...summarize(inWindow), streak: computeStreak(history) };
const groups = groupByDay(inWindow);
const title = windowTitle(period, window);
---

<BaseLayout title="Histórico - Zapt">
  <div id="main-content" class="min-h-screen bg-surface">
    <Header user={user} />

    <main class="container mx-auto px-4 py-6 md:py-10 max-w-3xl">
      <div class="mb-6">
        <h1 class="text-2xl md:text-3xl font-bold text-primary mb-1">📜 Meu Histórico</h1>
        <p class="text-gray-600 text-sm md:text-base">Suas missões concluídas e canceladas</p>
        <p class="text-secondary-dark font-bold text-lg mt-1">⭐ {me?.points ?? 0} pontos</p>
      </div>

      <HistoryView
        history={history}
        period={period}
        offset={offset}
        basePath="/crianca/historico"
        title={title}
        summary={summary}
        groups={groups}
      />
    </main>

    <footer class="bg-primary-dark text-white py-6 mt-auto">
      <div class="container mx-auto px-4 text-center">
        <p class="text-sm text-surface-light">© 2026 Zapt</p>
      </div>
    </footer>
  </div>
</BaseLayout>
