---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import { getMyChild, getTasks } from '@/lib/api';
import { requireChild } from '@/lib/auth';
import { CATEGORY_OPTIONS, type Child, type Task, type TaskCategory } from '@/lib/types';

/**
 * Missões da criança com o fluxo de aprovação por foto:
 *  - Para fazer (pending/in_progress): envia uma foto de comprovação.
 *    Se houver reviewerComment, mostra o feedback do responsável (pediu revisão).
 *  - Aguardando aprovação (pending_review): mostra a foto enviada.
 *  - Concluídas (completed).
 */
const session = await requireChild(Astro);
const { user, cookie } = session;

let me: Child | null = null;
let tasks: Task[] = [];
try {
  [me, tasks] = await Promise.all([
    getMyChild(cookie).catch(() => null),
    getTasks(cookie).catch((): Task[] => []),
  ]);
} catch (error) {
  console.error('Não foi possível carregar as missões:', error);
}

const categoryLabel = (c: TaskCategory) =>
  CATEGORY_OPTIONS.find((o) => o.value === c)?.label ?? c;

const formatDate = (iso: string) => {
  const [y, m, d] = iso.split('-');
  return `${d}/${m}/${y}`;
};

const todo = tasks.filter((t) => t.status === 'pending' || t.status === 'in_progress');
const waiting = tasks.filter((t) => t.status === 'pending_review');
const done = tasks.filter((t) => t.status === 'completed');
---

<BaseLayout title="Minhas Missões - Zapt">
  <div id="main-content" class="min-h-screen bg-surface">
    <Header user={user} />

    <main class="container mx-auto px-4 py-6 md:py-10 max-w-3xl">
      <div class="mb-6">
        <h1 class="text-2xl md:text-3xl font-bold text-primary mb-1">🎯 Minhas Missões</h1>
        <p class="text-gray-600 text-sm md:text-base">
          Ao terminar, envie uma foto para o responsável aprovar!
        </p>
        <p class="text-secondary-dark font-bold mt-1">⭐ {me?.points ?? 0} pontos</p>
      </div>

      {/* Para fazer */}
      <section class="mb-8">
        <h2 class="text-lg font-bold text-primary mb-3">Para fazer ({todo.length})</h2>
        {todo.length === 0 ? (
          <div class="bg-white rounded-xl shadow-md p-8 text-center">
            <p class="text-3xl mb-2">🌟</p>
            <p class="text-gray-600">Nenhuma missão pendente. Parabéns!</p>
          </div>
        ) : (
          <ul class="space-y-3" aria-label="Missões para fazer">
            {todo.map((t) => (
              <li class="bg-white rounded-xl shadow-md p-5">
                <div class="flex items-start justify-between gap-3 mb-2">
                  <div class="min-w-0">
                    <span class="inline-block text-xs text-gray-500 mb-1">{categoryLabel(t.category)}</span>
                    <h3 class="text-lg font-bold text-primary-dark">{t.title}</h3>
                    {t.description && <p class="text-sm text-gray-600 mt-0.5">{t.description}</p>}
                    <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-sm text-gray-500">
                      <span>📅 {formatDate(t.scheduledDate)} às {t.scheduledTime}</span>
                      <span class="font-semibold text-secondary-dark">⭐ +{t.rewardPoints} pts</span>
                    </div>
                  </div>
                </div>

                {/* Feedback do responsável (missão voltou para revisão) */}
                {t.reviewerComment && (
                  <div class="mt-2 mb-2 p-3 rounded-lg bg-action/10 border border-action/30">
                    <p class="text-xs font-semibold text-action-dark mb-0.5">🔁 O responsável pediu para revisar:</p>
                    <p class="text-sm text-primary-dark">{t.reviewerComment}</p>
                  </div>
                )}

                {/* Enviar comprovação */}
                <form class="enviar-form mt-3 flex flex-wrap items-center gap-2" data-id={t.id}>
                  <label class="inline-flex items-center gap-2 px-4 py-2 bg-secondary hover:bg-secondary-dark text-white text-sm font-medium rounded-lg cursor-pointer transition-colors">
                    📷 Escolher foto
                    <input type="file" accept="image/*" class="comprovante-input sr-only" required />
                  </label>
                  <span class="nome-arquivo text-xs text-gray-500 truncate max-w-[12rem]"></span>
                  <button
                    type="submit"
                    class="enviar-btn px-4 py-2 bg-highlight hover:bg-highlight-dark text-primary-dark text-sm font-semibold rounded-lg transition-colors disabled:opacity-50"
                    disabled
                  >
                    Enviar
                  </button>
                </form>
              </li>
            ))}
          </ul>
        )}
      </section>

      {/* Aguardando aprovação */}
      {waiting.length > 0 && (
        <section class="mb-8">
          <h2 class="text-lg font-bold text-primary mb-3">👀 Aguardando aprovação ({waiting.length})</h2>
          <ul class="space-y-3">
            {waiting.map((t) => (
              <li class="bg-white rounded-xl shadow-md p-5">
                <h3 class="font-bold text-primary-dark">{t.title}</h3>
                <p class="text-xs text-gray-500 mb-2">Você enviou a comprovação. Aguarde o responsável analisar.</p>
                {t.submissionImageUrl && (
                  <a href={t.submissionImageUrl} target="_blank" rel="noopener">
                    <img
                      src={t.submissionImageUrl}
                      alt="Comprovação"
                      class="rounded-lg max-h-48 w-auto border border-primary/10"
                    />
                  </a>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}

      {/* Concluídas */}
      {done.length > 0 && (
        <section>
          <h2 class="text-lg font-bold text-primary mb-3">Concluídas ({done.length})</h2>
          <ul class="space-y-2">
            {done.map((t) => (
              <li class="bg-white/60 rounded-xl shadow p-4 flex items-center justify-between gap-3">
                <span class="font-medium text-primary-dark truncate">✅ {t.title}</span>
                <span class="text-sm font-semibold text-secondary-dark whitespace-nowrap">+{t.rewardPoints} pts</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </main>

    <footer class="bg-primary-dark text-white py-6 mt-auto">
      <div class="container mx-auto px-4 text-center">
        <p class="text-sm text-surface-light">© 2026 Zapt</p>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  import { submitTask, ApiError } from '../../lib/api';

  // Habilita o botão "Enviar" só quando um arquivo é selecionado.
  document.querySelectorAll<HTMLFormElement>('.enviar-form').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('.comprovante-input')!;
    const nome = form.querySelector<HTMLElement>('.nome-arquivo')!;
    const btn = form.querySelector<HTMLButtonElement>('.enviar-btn')!;

    input.addEventListener('change', () => {
      const file = input.files?.[0];
      if (file) {
        nome.textContent = file.name;
        btn.disabled = false;
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const id = form.dataset.id;
      const file = input.files?.[0];
      if (!id || !file) return;

      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = 'Enviando...';
      try {
        await submitTask(id, file);
        window.location.reload();
      } catch (error) {
        const message = error instanceof ApiError ? error.message : 'Não foi possível enviar.';
        alert(message);
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  });
</script>
