---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import MissoesView from '@/components/missoes/MissoesView.astro';
import { getMyChild, getTasks } from '@/lib/api';
import { requireChild } from '@/lib/auth';
import {
  bucketByDay,
  filterInWindow,
  getWindow,
  normalizeOffset,
  normalizePeriod,
  scheduledTaskDate,
  summarizeMissions,
  windowTitle,
} from '@/lib/history';
import type { Child, Task } from '@/lib/types';

/**
 * Missões da criança, organizadas por período (padrão: hoje).
 * Agrupadas pela data AGENDADA — o que está previsto para hoje/esta semana.
 */
const session = await requireChild(Astro);
if(typeof session ==='string') return Astro.redirect(session);
const { user, cookie } = session;

let me: Child | null = null;
let tasks: Task[] = [];
try {
  [me, tasks] = await Promise.all([
    getMyChild(cookie).catch(() => null),
    getTasks(cookie).catch((): Task[] => []),
  ]);
} catch (error) {
  console.error('Não foi possível carregar as missões:', error);
}

const period = normalizePeriod(Astro.url.searchParams.get('periodo'), 'Child');
const offset = normalizeOffset(Astro.url.searchParams.get('offset'));

const window = getWindow(period, offset);
const inWindow = filterInWindow(tasks, window, scheduledTaskDate);
const summary = summarizeMissions(inWindow);
const buckets = bucketByDay(inWindow, scheduledTaskDate);
const title = windowTitle(period, window);
---

<BaseLayout title="Minhas Missões - Zapt">
  <div id="main-content" class="min-h-screen bg-surface">
    <Header user={user} />

    <main class="container mx-auto px-4 py-6 md:py-10 max-w-3xl">
      <div class="mb-6">
        <h1 class="text-2xl md:text-3xl font-bold text-primary mb-1">🎯 Minhas Missões</h1>
        <p class="text-gray-600 text-sm md:text-base">
          Ao terminar, envie uma foto para o responsável aprovar!
        </p>
        <p class="text-secondary-dark font-bold mt-1">⭐ {me?.points ?? 0} pontos</p>
      </div>

      <MissoesView
        period={period}
        offset={offset}
        basePath="/crianca/missoes"
        title={title}
        summary={summary}
        buckets={buckets}
      />
    </main>

    <footer class="bg-primary-dark text-white py-6 mt-auto">
      <div class="container mx-auto px-4 text-center">
        <p class="text-sm text-surface-light">© 2026 Zapt</p>
      </div>
    </footer>
  </div>
</BaseLayout>
