---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
---

<BaseLayout title="Criar conta - Zapt">
  <div id="main-content" class="min-h-screen bg-surface">
    <Header user={null} />

    <main class="container mx-auto px-4 py-10 md:py-16 max-w-md">
      <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
        <div class="bg-primary px-6 py-5">
          <h1 class="text-xl md:text-2xl font-bold text-white">Criar conta</h1>
          <p class="text-surface-light text-sm mt-1">Cadastro de responsável</p>
        </div>

        <form id="registerForm" class="p-6 md:p-8 space-y-5" aria-label="Cadastro de responsável">
          <div>
            <label for="fullName" class="block text-sm font-medium text-primary-dark mb-1.5">
              Nome
              <span class="text-action ml-1" aria-label="obrigatório">*</span>
            </label>
            <input
              type="text"
              id="fullName"
              name="fullName"
              required
              autocomplete="name"
              placeholder="Seu nome"
              class="w-full px-4 py-3 rounded-lg border-2 border-primary/30 focus:border-action focus:ring-2 focus:ring-action/20 outline-none transition-all"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-primary-dark mb-1.5">
              E-mail
              <span class="text-action ml-1" aria-label="obrigatório">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="voce@exemplo.com"
              class="w-full px-4 py-3 rounded-lg border-2 border-primary/30 focus:border-action focus:ring-2 focus:ring-action/20 outline-none transition-all"
            />
          </div>

          <div>
            <label for="password" class="block text-sm font-medium text-primary-dark mb-1.5">
              Senha
              <span class="text-action ml-1" aria-label="obrigatório">*</span>
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              minlength="6"
              autocomplete="new-password"
              placeholder="Mínimo 6 caracteres"
              class="w-full px-4 py-3 rounded-lg border-2 border-primary/30 focus:border-action focus:ring-2 focus:ring-action/20 outline-none transition-all"
            />
          </div>

          <button
            type="submit"
            class="w-full px-6 py-3 bg-action hover:bg-action-dark text-white font-semibold rounded-lg shadow-md transition-all disabled:opacity-50"
          >
            Criar conta
          </button>
        </form>

        <div id="registerFeedback" class="hidden mx-6 md:mx-8 mb-6 p-4 rounded-lg border text-sm font-medium" role="status" aria-live="polite"></div>

        <div class="px-6 md:px-8 pb-8 text-center">
          <p class="text-sm text-gray-600">
            Já tem conta?
            <a href="/login" class="text-primary font-medium hover:underline">Entrar</a>
          </p>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  import { register, ApiError } from '../lib/api';

  const form = document.getElementById('registerForm') as HTMLFormElement | null;
  const feedback = document.getElementById('registerFeedback');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) return;

    const data = Object.fromEntries(new FormData(form).entries()) as {
      fullName: string;
      email: string;
      password: string;
    };
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (btn) btn.disabled = true;

    try {
      await register(data);
      window.location.href = '/tarefas';
    } catch (error) {
      const message = error instanceof ApiError ? error.message : 'Não foi possível criar a conta.';
      showFeedback(message);
      if (btn) btn.disabled = false;
    }
  });

  function showFeedback(message: string) {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.className =
      'mx-6 md:mx-8 mb-6 p-4 rounded-lg border text-sm font-medium bg-action/20 border-action text-action-dark';
    feedback.classList.remove('hidden');
    feedback.setAttribute('role', 'alert');
  }
</script>
