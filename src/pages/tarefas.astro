---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import { getTasks } from '@/lib/api';
import { requireParent } from '@/lib/auth';
import {
  CATEGORY_OPTIONS,
  PRIORITY_OPTIONS,
  type Task,
  type TaskCategory,
  type TaskPriority,
} from '@/lib/types';

/**
 * Missões do responsável.
 *
 * Fluxo de aprovação: quando a criança envia a foto (pending_review), a missão
 * aparece em "Aguardando sua aprovação" com a imagem e botões Aprovar / Rejeitar.
 * As demais (pending/in_progress) ficam em "Em andamento" com a opção Cancelar.
 */
const session = await requireParent(Astro);
if(typeof session ==='string') return Astro.redirect(session);
const { user, cookie } = session;

let tasks: Task[] = [];
try {
  tasks = await getTasks(cookie);
} catch (error) {
  console.error('Não foi possível carregar as missões:', error);
}

const categoryLabel = (c: TaskCategory) =>
  CATEGORY_OPTIONS.find((o) => o.value === c)?.label ?? c;

const priorityInfo = (p: TaskPriority) =>
  PRIORITY_OPTIONS.find((o) => o.value === p);

const formatDate = (iso: string) => {
  const [y, m, d] = iso.split('-');
  return `${d}/${m}/${y}`;
};

// Pendentes de aprovação (criança enviou a foto) e em andamento.
const awaiting = tasks.filter((t) => t.status === 'pending_review');
const active = tasks.filter((t) => t.status === 'pending' || t.status === 'in_progress');
---

<BaseLayout title="Missões - Zapt">
  <div id="main-content" class="min-h-screen bg-surface">
    <Header user={user} />

    <main class="container mx-auto px-4 py-6 md:py-10 max-w-4xl">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 md:mb-8">
        <div>
          <h1 class="text-2xl md:text-3xl font-bold text-primary mb-1">Missões</h1>
          <p class="text-gray-600 text-sm md:text-base">
            Aprove as comprovações enviadas pelas crianças
          </p>
        </div>
        <a
          href="/cadastro-tarefas"
          class="inline-flex items-center gap-2 px-4 py-2 bg-action hover:bg-action-dark text-white rounded-lg text-sm font-medium transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Nova Missão
        </a>
      </div>

      {/* Aguardando aprovação */}
      <section class="mb-8">
        <h2 class="text-lg font-bold text-primary mb-3">
          👀 Aguardando sua aprovação ({awaiting.length})
        </h2>
        {awaiting.length === 0 ? (
          <p class="text-sm text-gray-500">Nenhuma comprovação aguardando.</p>
        ) : (
          <div class="grid gap-4 md:grid-cols-2">
            {awaiting.map((t) => {
              const priority = priorityInfo(t.priority);
              return (
                <article class="bg-white rounded-xl shadow-md p-5 flex flex-col">
                  <div class="flex items-center justify-between gap-2 mb-1">
                    <span class="text-xs text-gray-500">{categoryLabel(t.category)}</span>
                    {priority && (
                      <span class={`px-2 py-0.5 rounded-full text-xs font-medium text-white ${priority.color}`}>
                        {priority.label}
                      </span>
                    )}
                  </div>
                  <h3 class="text-lg font-bold text-primary-dark">{t.title}</h3>
                  <div class="text-sm text-gray-500 mt-1 mb-3">
                    ⭐ +{t.rewardPoints} pts · 📅 {formatDate(t.scheduledDate)}
                  </div>

                  {t.submissionImageUrl && (
                    <a href={t.submissionImageUrl} class="lightbox-trigger block mb-3">
                      <img
                        src={t.submissionImageUrl}
                        alt="Comprovação"
                        class="rounded-lg w-full max-h-56 object-cover border border-primary/10"
                      />
                    </a>
                  )}

                  <div class="mt-auto flex gap-2">
                    <button
                      type="button"
                      class="aprovar-btn flex-1 px-4 py-2 bg-highlight hover:bg-highlight-dark text-primary-dark font-semibold rounded-lg text-sm transition-colors disabled:opacity-50"
                      data-id={t.id}
                    >
                      ✅ Aprovar
                    </button>
                    <button
                      type="button"
                      class="rejeitar-btn flex-1 px-4 py-2 bg-action hover:bg-action-dark text-white font-semibold rounded-lg text-sm transition-colors disabled:opacity-50"
                      data-id={t.id}
                    >
                      🔁 Rejeitar
                    </button>
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </section>

      {/* Em andamento */}
      <section>
        <h2 class="text-lg font-bold text-primary mb-3">Em andamento ({active.length})</h2>
        {active.length === 0 ? (
          <div class="bg-white rounded-xl shadow-md p-10 text-center">
            <p class="text-3xl mb-2">🎯</p>
            <p class="text-gray-600">Nenhuma missão em andamento.</p>
          </div>
        ) : (
          <section class="grid gap-4" aria-label="Missões em andamento">
            {active.map((task) => {
              const priority = priorityInfo(task.priority);
              return (
                <article class="bg-white rounded-xl shadow-md p-5">
                  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 mb-1">
                        <span class="text-xs text-gray-500">{categoryLabel(task.category)}</span>
                      </div>
                      <h3 class="text-lg font-bold text-primary-dark truncate">{task.title}</h3>
                      {task.description && (
                        <p class="text-sm text-gray-600 mt-1">{task.description}</p>
                      )}
                      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-2 text-sm text-gray-500">
                        <span>📅 {formatDate(task.scheduledDate)} às {task.scheduledTime}</span>
                        <span class="font-semibold text-secondary-dark">⭐ +{task.rewardPoints} pts</span>
                      </div>
                    </div>
                    <div class="flex items-center gap-2 flex-shrink-0">
                      {priority && (
                        <span class={`px-2.5 py-0.5 rounded-full text-xs font-medium text-white ${priority.color}`}>
                          {priority.label}
                        </span>
                      )}
                      <button
                        type="button"
                        class="cancelar-btn px-4 py-2 bg-action hover:bg-action-dark text-white font-semibold rounded-lg text-sm transition-colors disabled:opacity-50"
                        data-id={task.id}
                      >
                        Cancelar
                      </button>
                    </div>
                  </div>
                </article>
              );
            })}
          </section>
        )}
      </section>
    </main>

    <footer class="bg-primary-dark text-white py-6 mt-auto">
      <div class="container mx-auto px-4 text-center">
        <p class="text-sm text-surface-light">© 2026 Zapt</p>
      </div>
    </footer>
  </div>

   <div id="lightbox" class="hidden fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4"
        role="dialog" aria-modal="true" aria-label="Comprovação expandida">
     <img id="lightbox-img" src="" alt="Comprovação" class="max-h-full max-w-full rounded-lg shadow-2xl" />
     <button id="lightbox-close" class="absolute top-4 right-4 text-white text-4xl leading-none" aria-label="Fechar">×</button>
   </div>
  
</BaseLayout>

<script>
  import { approveTask, rejectTask, skipTask, ApiError } from '../lib/api';

  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement| null;
  const closeLightbox = () => {lightbox?.classList.add('hidden'); if (lightboxImg) lightboxImg.src = ''; };

  document.querySelectorAll<HTMLAnchorElement>('a.lightbox-trigger').forEach((a) => {
     a.addEventListener('click', (e) => {
       e.preventDefault();
       if (lightbox && lightboxImg) { lightboxImg.src = a.href; lightbox.classList.remove('hidden'); }
     });
   });
   lightbox?.addEventListener('click', closeLightbox);
   document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });

  document.querySelectorAll<HTMLButtonElement>('.aprovar-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      if (!id) return;
      btn.disabled = true;
      btn.textContent = 'Aprovando...';
      try {
        await approveTask(id);
        window.location.reload();
      } catch (error) {
        alert(error instanceof ApiError ? error.message : 'Não foi possível aprovar.');
        btn.disabled = false;
        btn.textContent = '✅ Aprovar';
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.rejeitar-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      if (!id) return;
      const comment = window.prompt('O que precisa ser revisto?');
      if (comment === null) return; // cancelou
      if (!comment.trim()) {
        alert('Informe o que precisa ser revisto.');
        return;
      }
      btn.disabled = true;
      btn.textContent = 'Rejeitando...';
      try {
        await rejectTask(id, comment.trim());
        window.location.reload();
      } catch (error) {
        alert(error instanceof ApiError ? error.message : 'Não foi possível rejeitar.');
        btn.disabled = false;
        btn.textContent = '🔁 Rejeitar';
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.cancelar-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      if (!id) return;
      if (!confirm('Cancelar esta missão? Ela não concederá pontos.')) return;
      btn.disabled = true;
      btn.textContent = 'Cancelando...';
      try {
        await skipTask(id);
        window.location.reload();
      } catch (error) {
        alert(error instanceof ApiError ? error.message : 'Não foi possível cancelar.');
        btn.disabled = false;
        btn.textContent = 'Cancelar';
      }
    });
  });
</script>
