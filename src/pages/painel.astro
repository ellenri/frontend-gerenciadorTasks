---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import { getChildren } from '@/lib/api';
import { requireParent } from '@/lib/auth';
import type { Child } from '@/lib/types';

/**
 * Painel do responsável: visão geral com atalhos para os cadastros e
 * resumo das crianças cadastradas (cada uma com seus pontos).
 */
const session = await requireParent(Astro);

if(typeof session ==='string') return Astro.redirect(session);
const { user, cookie } = session;

let children: Child[] = [];
try {
  children = await getChildren(cookie);
} catch (error) {
  console.error('Não foi possível carregar as crianças:', error);
}

const totalPoints = children.reduce((s, c) => s + (c.points ?? 0), 0);
---

<BaseLayout title="Painel - Zapt">
  <div id="main-content" class="min-h-screen bg-surface">
    <Header user={user} />

    <main class="container mx-auto px-4 py-6 md:py-10 max-w-5xl">
      <!-- Cabeçalho -->
      <div class="mb-6 md:mb-8">
        <h1 class="text-2xl md:text-3xl font-bold text-primary mb-1">
          Olá, {user.fullName.split(' ')[0]}! 👋
        </h1>
        <p class="text-gray-600 text-sm md:text-base">
          Gerencie missões, recompensas e acompanhe o progresso das crianças.
        </p>
      </div>

      <!-- Ações rápidas -->
      <section class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 mb-8">
        <a href="/cadastro-tarefas" class="bg-action hover:bg-action-dark text-white rounded-xl p-4 md:p-5 shadow-md transition-colors flex flex-col gap-2">
          <span class="text-2xl">🎯</span>
          <span class="font-semibold text-sm md:text-base">Nova Missão</span>
        </a>
        <a href="/cadastro-criancas" class="bg-secondary hover:bg-secondary-dark text-white rounded-xl p-4 md:p-5 shadow-md transition-colors flex flex-col gap-2">
          <span class="text-2xl">🧒</span>
          <span class="font-semibold text-sm md:text-base">Nova Criança</span>
        </a>
        <a href="/cadastro-recompensas" class="bg-primary hover:bg-primary-dark text-white rounded-xl p-4 md:p-5 shadow-md transition-colors flex flex-col gap-2">
          <span class="text-2xl">🎁</span>
          <span class="font-semibold text-sm md:text-base">Nova Recompensa</span>
        </a>
        <a href="/ranking" class="bg-highlight hover:bg-highlight-dark text-primary-dark rounded-xl p-4 md:p-5 shadow-md transition-colors flex flex-col gap-2">
          <span class="text-2xl">🏆</span>
          <span class="font-semibold text-sm md:text-base">Ranking</span>
        </a>
      </section>

      <!-- Resumo das crianças -->
      <section>
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-lg md:text-xl font-bold text-primary">Crianças</h2>
          <a href="/cadastro-criancas" class="text-sm text-primary hover:underline">+ adicionar</a>
        </div>

        {children.length === 0 ? (
          <div class="bg-white rounded-xl shadow-md p-8 text-center">
            <p class="text-gray-600 mb-4">Você ainda não cadastrou nenhuma criança.</p>
            <a href="/cadastro-criancas" class="inline-flex items-center gap-2 px-5 py-2.5 bg-action hover:bg-action-dark text-white font-semibold rounded-lg transition-colors">
              Cadastrar primeira criança
            </a>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {children.map((c) => (
              <article class="bg-white rounded-xl shadow-md p-5 flex items-center gap-4">
                <div class="w-14 h-14 rounded-full bg-surface flex items-center justify-center overflow-hidden flex-shrink-0">
                  {c.avatar ? (
                    <img src={c.avatar} alt={c.name} class="w-full h-full object-cover" />
                  ) : (
                    <span class="text-2xl">🧒</span>
                  )}
                </div>
                <div class="min-w-0 flex-1">
                  <h3 class="font-bold text-primary-dark truncate">{c.name}</h3>
                  <p class="text-sm text-secondary-dark font-semibold">⭐ {c.points ?? 0} pontos</p>
                </div>
                <a
                  href={`/editar-crianca/${c.id}`}
                  class="flex-shrink-0 text-sm font-medium text-primary hover:text-primary-dark border border-primary/30 hover:border-primary rounded-lg px-3 py-1.5 transition-colors whitespace-nowrap"
                >
                  ✏️ Editar
                </a>
              </article>
            ))}
          </div>
        )}

        {children.length > 0 && (
          <p class="text-center text-sm text-gray-500 mt-4">
            Total acumulado: <strong class="text-secondary-dark">⭐ {totalPoints} pontos</strong>
          </p>
        )}
      </section>
    </main>

    <footer class="bg-primary-dark text-white py-6 mt-auto">
      <div class="container mx-auto px-4 text-center">
        <p class="text-sm text-surface-light">© 2026 Zapt</p>
      </div>
    </footer>
  </div>
</BaseLayout>
