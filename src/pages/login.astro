---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Entrar - Zapt">
  <div id="main-content" class="min-h-screen bg-surface flex items-center justify-center px-4">
    <main class="w-full max-w-4xl bg-white rounded-2xl shadow-xl overflow-hidden grid md:grid-cols-2">

       <!-- coluna ESQUERDA: painel da imagem (some no mobile) -->
      <div class="hidden md:flex  items-center justify-center p-10">
      <img src="/zapt/home_com_estrela_arriba.png" alt="Zapt" class="w-full max-w-sm" />
      </div>

        <!-- Mobile: faixinha compacta acima do form (dentro da coluna direita) -->
   <div class="md:hidden flex justify-center mb-4">
     <img src="/zapt/home_com_estrela_arriba.png" alt="Zapt" class="w-44" />
   </div>

      <div class="bg-white rounded-2xl shadow-xl overflow-hidden w-full">
        <div class="bg-primary px-5 py-2">
          <h1 class="text-lg md:text-xl font-bold text-white">Entrar</h1>
          <p class="text-surface-light text-sm mt-1">Acesse para gerenciar as missões</p>
        </div>

        <form id="loginForm" class="p-6 md:p-8 space-y-5" aria-label="Login">
          <div>
            <label for="email" class="block text-sm font-medium text-primary-dark mb-1.5">
              E-mail
              <span class="text-action ml-1" aria-label="obrigatório">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="voce@exemplo.com"
              class="w-full px-4 py-3 rounded-lg border-2 border-primary/30 focus:border-action focus:ring-2 focus:ring-action/20 outline-none transition-all"
            />
          </div>

          <div>
            <label for="password" class="block text-sm font-medium text-primary-dark mb-1.5">
              Senha
              <span class="text-action ml-1" aria-label="obrigatório">*</span>
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              placeholder="••••••"
              class="w-full px-4 py-3 rounded-lg border-2 border-primary/30 focus:border-action focus:ring-2 focus:ring-action/20 outline-none transition-all"
            />
          </div>

          <button
            type="submit"
            class="w-full px-6 py-3 bg-action hover:bg-action-dark text-white font-semibold rounded-lg shadow-md transition-all disabled:opacity-50"
          >
            Entrar
          </button>
        </form>

        <div id="loginFeedback" class="hidden mx-6 md:mx-8 mb-6 p-4 rounded-lg border text-sm font-medium" role="status" aria-live="polite"></div>

        <div class="px-6 md:px-8 pb-8 text-center">
          <p class="text-sm text-gray-600">
            Não tem conta?
            <a href="/registro" class="text-primary font-medium hover:underline">Criar conta</a>
          </p>
        </div>
      </div>

      <p class="text-center text-xs text-gray-500 mt-4">
        Ambiente de desenvolvimento: responsavel@exemplo.com / 123456
      </p>
    </main>
  </div>
</BaseLayout>

<script>
  import { login, ApiError } from '../lib/api';
  import { homeForRole } from '../lib/auth';

  const form = document.getElementById('loginForm') as HTMLFormElement | null;
  const feedback = document.getElementById('loginFeedback');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) return;

    const data = Object.fromEntries(new FormData(form).entries()) as {
      email: string;
      password: string;
    };
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (btn) btn.disabled = true;

    try {
      const user = await login(data);
      // Redireciona para a área certa de cada papel:
      //   Parent -> /painel  |  Child -> /crianca
      window.location.href = homeForRole(user.role);
    } catch (error) {
      const message = error instanceof ApiError ? error.message : 'Não foi possível entrar.';
      showFeedback(message);
      if (btn) btn.disabled = false;
    }
  });

  function showFeedback(message: string) {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.className =
      'mx-6 md:mx-8 mb-6 p-4 rounded-lg border text-sm font-medium bg-action/20 border-action text-action-dark';
    feedback.classList.remove('hidden');
    feedback.setAttribute('role', 'alert');
  }
</script>
