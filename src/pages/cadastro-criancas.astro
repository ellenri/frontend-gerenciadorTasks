---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import { AVATAR_OPTIONS } from '@/lib/types';
import { requireParent } from '@/lib/auth';
import { localToday } from '@/lib/dates';

const today = localToday();

// Exige login de responsável (só pais cadastram crianças).
const session = await requireParent(Astro);
if(typeof session ==='string') return Astro.redirect(session);
const { user } = session;

// Data máxima = hoje (não aceita data futura). Igual à validação do domínio.
---

<BaseLayout title="Nova Criança - Zapt">
  <div id="main-content" class="min-h-screen bg-surface">
    <Header user={user} />

    <main class="container mx-auto px-4 py-6 md:py-10 max-w-2xl">
      <!-- Migalha -->
      <nav class="mb-6 text-sm" aria-label="Navegação">
        <a href="/" class="text-primary hover:text-primary-dark">Início</a>
        <span class="text-primary/60"> / </span>
        <a href="/ranking" class="text-primary hover:text-primary-dark">Ranking</a>
        <span class="text-primary/60"> / </span>
        <span class="text-primary font-medium" aria-current="page">Nova Criança</span>
      </nav>

      <!-- Título -->
      <div class="mb-6">
        <h1 class="text-2xl md:text-3xl font-bold text-primary mb-1">Nova Criança</h1>
        <p class="text-gray-600 text-sm md:text-base">
          Cadastre uma criança e escolha o avatar que ela vai usar nas missões!
        </p>
      </div>

      <section class="bg-white rounded-2xl shadow-xl overflow-hidden">
        <!-- Cabeçalho -->
        <div class="bg-primary px-6 py-5">
          <h2 class="text-xl font-bold text-white">Dados da Criança</h2>
        </div>

        <form id="childForm" class="p-6 md:p-8 space-y-6" aria-label="Cadastro de criança">
          <!-- Nome -->
          <div>
            <label for="name" class="block text-sm font-medium text-primary-dark mb-1.5">
              Nome
              <span class="text-action ml-1" aria-label="obrigatório">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Ex: Ana Clara"
              class="w-full px-4 py-3 rounded-lg border-2 border-primary/30 focus:border-action focus:ring-2 focus:ring-action/20 outline-none transition-all"
            />
          </div>

          <!-- Data de Nascimento -->
          <div>
            <label for="birthDate" class="block text-sm font-medium text-primary-dark mb-1.5">
              Data de Nascimento
              <span class="text-action ml-1" aria-label="obrigatório">*</span>
            </label>
            <input
              type="date"
              id="birthDate"
              name="birthDate"
              required
              max={today}
              class="w-full px-4 py-3 rounded-lg border-2 border-primary/30 focus:border-action focus:ring-2 focus:ring-action/20 outline-none transition-all"
            />
          </div>

          <!-- Escolha de Avatar -->
          <div>
            <span class="block text-sm font-medium text-primary-dark mb-2">
              Escolha o Avatar
              <span class="text-action ml-1" aria-label="obrigatório">*</span>
            </span>
            <div class="grid grid-cols-4 gap-3" role="radiogroup" aria-required="true">
              {AVATAR_OPTIONS.map((avatar) => (
                <label class="relative cursor-pointer group">
                  <input
                    type="radio"
                    name="avatar"
                    value={avatar}
                    required
                    class="peer sr-only"
                  />
                  <div
                    class="rounded-xl border-2 border-primary/20 bg-surface overflow-hidden peer-checked:border-action peer-checked:ring-2 peer-checked:ring-action/30 hover:border-action hover:shadow-md transition-all"
                  >
                    <img
                      src={avatar}
                      alt="Avatar disponível"
                      class="w-full aspect-square object-cover"
                    />
                  </div>
                </label>
              ))}
            </div>
          </div>

          <!-- Acesso da criança (login próprio) -->
          <div class="pt-4 border-t border-primary/10">
            <p class="text-sm font-medium text-primary-dark mb-3">
              Acesso da criança
              <span class="text-gray-500 font-normal">(e-mail + senha que ela vai usar para entrar)</span>
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="email" class="block text-sm font-medium text-primary-dark mb-1.5">
                  E-mail
                  <span class="text-action ml-1" aria-label="obrigatório">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="username"
                  placeholder="ana@exemplo.com"
                  class="w-full px-4 py-3 rounded-lg border-2 border-primary/30 focus:border-action focus:ring-2 focus:ring-action/20 outline-none transition-all"
                />
              </div>
              <div>
                <label for="password" class="block text-sm font-medium text-primary-dark mb-1.5">
                  Senha
                  <span class="text-action ml-1" aria-label="obrigatório">*</span>
                </label>
                <input
                  type="password"
                  id="password"
                  name="password"
                  required
                  minlength="6"
                  autocomplete="new-password"
                  placeholder="mín. 6 caracteres"
                  class="w-full px-4 py-3 rounded-lg border-2 border-primary/30 focus:border-action focus:ring-2 focus:ring-action/20 outline-none transition-all"
                />
              </div>
            </div>
          </div>

          <!-- Botões -->
          <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-primary/10">
            <button
              type="submit"
              class="flex-1 px-6 py-3 bg-action hover:bg-action-dark text-white font-semibold rounded-lg shadow-md transition-all disabled:opacity-50"
            >
              Criar Criança
            </button>
            <button
              type="reset"
              class="px-6 py-3 bg-secondary hover:bg-secondary-dark text-white font-medium rounded-lg shadow-md transition-all"
            >
              Limpar
            </button>
          </div>
        </form>
      </section>

      <!-- Feedback do envio -->
      <div id="childFeedback" class="hidden mt-4" role="status" aria-live="polite"></div>
    </main>

    <footer class="bg-primary-dark text-white py-6 mt-auto">
      <div class="container mx-auto px-4 text-center">
        <p class="text-sm text-surface-light">© 2026 Zapt</p>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  import { createChild, ApiError } from '../lib/api';
  import type { CreateChildRequest } from '../lib/types';

  const form = document.getElementById('childForm') as HTMLFormElement | null;
  const feedback = document.getElementById('childFeedback');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) return;

    const data = Object.fromEntries(new FormData(form).entries());
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitButton) submitButton.disabled = true;

    try {
      await createChild(data as unknown as CreateChildRequest);
      showFeedback('success', 'Criança cadastrada! 🎉 Veja no Ranking.');
      form.reset();
    } catch (error) {
      const message = error instanceof ApiError
        ? error.message
        : 'Não foi possível cadastrar. Tente novamente.';
      showFeedback('error', message);
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });

  function showFeedback(type: 'success' | 'error', message: string) {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.className = 'mt-4 p-4 rounded-lg border text-sm font-medium ' +
      (type === 'success'
        ? 'bg-highlight/30 border-highlight text-primary-dark'
        : 'bg-action/20 border-action text-action-dark');
    feedback.classList.remove('hidden');
    feedback.setAttribute('role', type === 'error' ? 'alert' : 'status');
  }
</script>
