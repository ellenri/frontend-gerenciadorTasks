---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import HistoryView from '@/components/history/HistoryView.astro';
import { getTasks, getChildren } from '@/lib/api';
import { requireParent } from '@/lib/auth';
import {
  filterInWindow,
  computeStreak,
  getWindow,
  groupByDay,
  normalizeOffset,
  normalizePeriod,
  summarize,
  windowTitle,
} from '@/lib/history';
import type { Child, Task } from '@/lib/types';

/**
 * Histórico do responsável: missões concluídas e canceladas que ele criou,
 * organizadas por período (padrão: semana).
 */
const session = await requireParent(Astro);
if (typeof session === 'string') return Astro.redirect(session);
if(typeof session ==='string') return Astro.redirect(session);
const { user, cookie } = session;

const [tasksResult, childrenResult] = await Promise.all([
  getTasks(cookie).catch((): Task[] => []),
  getChildren(cookie).catch((): Child[] => []),
]);

const children = childrenResult;
const childName = (id: string) => children.find((c) => c.id === id)?.name ?? '—';

// Histórico global = concluídas + canceladas (de qualquer período).
const history = tasksResult.filter(
  (t) => t.status === 'completed' || t.status === 'skipped',
);

const childFilter = Astro.url.searchParams.get('crianca');
const filteredHistory = childFilter
? history.filter((t) => t.assignedTo === childFilter) : history;

const period = normalizePeriod(Astro.url.searchParams.get('periodo'), 'Parent');
const offset = normalizeOffset(Astro.url.searchParams.get('offset'));

const window = getWindow(period, offset);
const inWindow = filterInWindow(filteredHistory, window);
const summary = { ...summarize(inWindow), streak: computeStreak(filteredHistory) };
const groups = groupByDay(inWindow);
const title = windowTitle(period, window);
---

<BaseLayout title="Histórico - Zapt">
  <div id="main-content" class="min-h-screen bg-surface">
    <Header user={user} />

    <main class="container mx-auto px-4 py-6 md:py-10 max-w-4xl">
      <div class="mb-6">
        <h1 class="text-2xl md:text-3xl font-bold text-primary mb-1">📜 Histórico</h1>
        <p class="text-gray-600 text-sm md:text-base">
          Missões concluídas e canceladas
        </p>
      </div>

      <HistoryView
        history={history}
        period={period}
        offset={offset}
        basePath="/historico"
        title={title}
        summary={summary}
        groups={groups}
        childName={childName}
      />
    </main>

    <footer class="bg-primary-dark text-white py-6 mt-auto">
      <div class="container mx-auto px-4 text-center">
        <p class="text-sm text-surface-light">© 2026 Zapt</p>
      </div>
    </footer>
  </div>
</BaseLayout>
