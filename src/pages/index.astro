---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import { getSession } from '@/lib/auth';

// Sessão opcional: a home é pública, mas o cabeçalho mostra Entrar/Sair.
const session = await getSession(Astro);
const user = session?.user ?? null;
---

<BaseLayout title="Zapt - Início">
  <div id="main-content" class="min-h-screen bg-surface">
    <Header user={user} />

    <main class="container mx-auto px-4 py-8 md:py-16">
      <!-- Hero Section -->
      <section class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
        <div class="inline-block mb-4">
          <img
            src="/public/zapt/logo-home-transparent.png"
            alt="Troféu"
            class="w-36 h-36 md:w-24 md:h-24 mx-auto "
          />
        </div>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-primary mb-4">
          Zapt
        </h1>
        <p class="text-lg md:text-xl text-gray-700 mb-6">
          Transforme tarefas em missões divertidas com recompensas pela conquista
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="/cadastro-tarefas"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-action hover:bg-action-dark text-white font-semibold rounded-lg shadow-md transition-all duration-200"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 4.5v15m7.5-7.5h-15"
              />
            </svg>
            Nova Tarefa
          </a>
          <a
            href="/tarefas"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary hover:bg-primary-dark text-white font-semibold rounded-lg shadow-md transition-all duration-200"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"
              />
            </svg>
            Ver Missões
          </a>
          <a
            href="/ranking"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-secondary hover:bg-secondary-dark text-white font-semibold rounded-lg shadow-md transition-all duration-200"
          >
            🏆 Ver Ranking
          </a>
        </div>
      </section>

      <!-- Features Grid -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <!-- Feature 1 -->
        <article class="bg-white rounded-xl p-6 shadow-md hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-6 h-6 text-white"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"
              />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-primary mb-2">Agendamento</h3>
          <p class="text-gray-600 text-sm">
            Agende tarefas com data e hora específicas para ajudar na organização do dia a dia.
          </p>
        </article>

        <!-- Feature 2 -->
        <article class="bg-white rounded-xl p-6 shadow-md hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-action rounded-lg flex items-center justify-center mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-6 h-6 text-white"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"
              />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-primary mb-2">Notificações</h3>
          <p class="text-gray-600 text-sm">
            A criança recebe notificações no horário de cada tarefa para não esquecer.
          </p>
        </article>

        <!-- Feature 3 -->
        <article class="bg-white rounded-xl p-6 shadow-md hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-secondary rounded-lg flex items-center justify-center mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-6 h-6 text-white"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"
              />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-primary mb-2">Gamificação</h3>
          <p class="text-gray-600 text-sm">
            Sistema de conquistas para motivar as crianças a completarem as tarefas.
          </p>
        </article>
      </section>
    </main>

    <!-- Footer -->
    <footer class="bg-primary-dark text-white py-6 mt-auto">
      <div class="container mx-auto px-4 text-center">
        <p class="text-sm text-surface-light">
          © 2026 Zapt - Gerenciando responsabilidades com carinho
        </p>
      </div>
    </footer>
  </div>
</BaseLayout>
