---
/**
 * Formulário completo para cadastro de tarefas
 * Responsivo e acessível
 */
import { getChildren } from '@/lib/api';
import { CATEGORY_OPTIONS, PRIORITY_OPTIONS, RECURRENCE_OPTIONS, REMINDER_OPTIONS, WEEKDAY_OPTIONS, type Child } from '@/lib/types';
import { localToday } from '@/lib/dates';

const today = localToday();

// Buscar crianças da API (resiliente: se a API estiver fora, lista vazia).
let children: Child[] = [];
try {
  children = await getChildren(Astro.request.headers.get('cookie') ?? '');
} catch (error) {
  console.error('Não foi possível carregar as crianças:', error);
}

// Opções de duração estimada
const DURATION_OPTIONS = [
  { value: '15', label: '15 minutos' },
  { value: '30', label: '30 minutos' },
  { value: '45', label: '45 minutos' },
  { value: '60', label: '1 hora' },
  { value: '90', label: '1h 30min' },
  { value: '120', label: '2 horas' },
];

// Data mínima para agendamento (hoje)
//local (nao usar UTC) a noite (depois das 21 horas) UTC vira dia seginte )
---

<section class="w-full max-w-2xl mx-auto">
  <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
    <!-- Cabeçalho do Formulário -->
    <div class="bg-primary px-6 py-5 md:px-8 md:py-6">
      <h2 class="text-xl md:text-2xl font-bold text-white">Nova Missão</h2>
      <p class="text-surface-light text-sm md:text-base mt-1">
        Crie uma nova missão para uma criança completar
      </p>
    </div>

    <!-- Formulário -->
    <form
      id="taskForm"
      class="p-6 md:p-8 space-y-6"
      aria-label="Formulário de cadastro de missão"
    >
      <!-- Título da Missão -->
      <div>
        <label for="title" class="block text-sm font-medium text-primary-dark mb-1.5">
          Título da Missão
          <span class="text-action ml-1" aria-label="obrigatório">*</span>
        </label>
        <input
          type="text"
          id="title"
          name="title"
          required
          placeholder="Ex: Derrotar o Dragão da Matemática"
          class="w-full px-4 py-3 rounded-lg border-2 border-primary/30 focus:border-action focus:ring-2 focus:ring-action/20 outline-none transition-all"
          aria-describedby="titleHelp"
        />
        <p id="titleHelp" class="text-sm text-gray-500 mt-1">
          Um nome épico para a missão
        </p>
      </div>

      <!-- Descrição -->
      <div>
        <label for="description" class="block text-sm font-medium text-primary-dark mb-1.5">
          Descrição
        </label>
        <textarea
          id="description"
          name="description"
          rows="3"
          placeholder="Adicione detalhes épicos sobre a missão (opcional)"
          class="w-full px-4 py-3 rounded-lg border-2 border-primary/30 focus:border-action focus:ring-2 focus:ring-action/20 outline-none transition-all resize-y"
        ></textarea>
      </div>

      <!-- Grid 2 colunas: Categoria e Prioridade -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Categoria -->
        <div>
          <label for="category" class="block text-sm font-medium text-primary-dark mb-1.5">
            Categoria
            <span class="text-action ml-1" aria-label="obrigatório">*</span>
          </label>
          <select
            id="category"
            name="category"
            required
            class="w-full px-4 py-3 rounded-lg border-2 border-primary/30 focus:border-action focus:ring-2 focus:ring-action/20 outline-none transition-all bg-white cursor-pointer"
          >
            <option value="" disabled selected>Selecione uma categoria</option>
            {CATEGORY_OPTIONS.map((cat) => (
              <option value={cat.value}>{cat.label}</option>
            ))}
          </select>
        </div>

        <!-- Duração Estimada -->
        <div>
          <label for="duration" class="block text-sm font-medium text-primary-dark mb-1.5">
            Duração Estimada
          </label>
          <select
            id="duration"
            name="duration"
            class="w-full px-4 py-3 rounded-lg border-2 border-primary/30 focus:border-action focus:ring-2 focus:ring-action/20 outline-none transition-all bg-white cursor-pointer"
          >
            <option value="" disabled selected>Estimativa de tempo</option>
            {DURATION_OPTIONS.map((dur) => (
              <option value={dur.value}>{dur.label}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Prioridade -->
      <div>
        <span class="block text-sm font-medium text-primary-dark mb-2">
          Prioridade
          <span class="text-action ml-1" aria-label="obrigatório">*</span>
        </span>
        <div class="flex flex-wrap gap-3" role="radiogroup" aria-required="true">
          {PRIORITY_OPTIONS.map((priority) => (
            <label class="relative cursor-pointer group">
              <input
                type="radio"
                name="priority"
                value={priority.value}
                required
                class="peer sr-only"
              />
              <div
                class={`
                  px-4 py-2.5 md:px-5 md:py-3
                  rounded-lg border-2
                  transition-all duration-200
                  ${priority.color} text-white
                  border-primary/20
                  peer-checked:border-action peer-checked:ring-2 peer-checked:ring-action/30
                  hover:shadow-md
                `}
              >
                <span class="font-medium text-sm md:text-base">{priority.label}</span>
              </div>
            </label>
          ))}
        </div>
      </div>

      <!-- Data e Hora -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="scheduledDate" class="block text-sm font-medium text-primary-dark mb-1.5">
            Data
            <span class="text-action ml-1" aria-label="obrigatório">*</span>
          </label>
          <input
            type="date"
            id="scheduledDate"
            name="scheduledDate"
            required
            min={today}
            class="w-full px-4 py-3 rounded-lg border-2 border-primary/30 focus:border-action focus:ring-2 focus:ring-action/20 outline-none transition-all"
          />
        </div>
        <div>
          <label for="scheduledTime" class="block text-sm font-medium text-primary-dark mb-1.5">
            Horário
            <span class="text-action ml-1" aria-label="obrigatório">*</span>
          </label>
          <input
            type="time"
            id="scheduledTime"
            name="scheduledTime"
            required
            class="w-full px-4 py-3 rounded-lg border-2 border-primary/30 focus:border-action focus:ring-2 focus:ring-action/20 outline-none transition-all"
          />
        </div>
      </div>

      <!-- Repetição -->
      <div>
        <label for="recurrenceType" class="block text-sm font-medium text-primary-dark mb-1.5">
          Repetição
          <span class="text-action ml-1" aria-label="obrigatório">*</span>
        </label>
        <select
          id="recurrenceType"
          name="recurrenceType"
          required
          class="w-full px-4 py-3 rounded-lg border-2 border-primary/30 focus:border-action focus:ring-2 focus:ring-action/20 outline-none transition-all bg-white cursor-pointer"
        >
          {RECURRENCE_OPTIONS.map((r) => (
            <option value={r.value}>{r.label}</option>
          ))}
        </select>
        <p class="text-xs text-gray-500 mt-1" id="recurrenceHelp">Recorrências geram uma missão por ocorrência (8 semanas).</p>
      </div>

      <!-- Dias da semana (somente para recorrência) -->
      <div id="recurrenceDaysBlock" class="hidden">
        <span class="block text-sm font-medium text-primary-dark mb-2" id="recurrenceDaysLabel">
          Dia(s) da semana <span class="text-action ml-1" aria-label="obrigatório">*</span>
        </span>
        <div class="flex flex-wrap gap-2">
          {WEEKDAY_OPTIONS.map((d) => (
            <label class="cursor-pointer">
              <input type="checkbox" name="recurrenceDays" value={d.value} class="peer sr-only" />
              <div class="w-12 h-12 flex items-center justify-center rounded-lg border-2 border-primary/30 text-sm font-medium peer-checked:border-action peer-checked:bg-action peer-checked:text-white hover:border-action transition-all">
                {d.label}
              </div>
            </label>
          ))}
        </div>
      </div>

      <!-- Lembretes (avisar antes / na hora) -->
      <div>
        <span class="block text-sm font-medium text-primary-dark mb-1.5">
          Lembretes
        </span>
        <p class="text-xs text-gray-500 mb-3">Avise a criança sobre esta missão.</p>
        <div class="space-y-3">
          <label class="flex items-center gap-3 cursor-pointer">
            <input
              type="checkbox"
              name="remindAtStart"
              class="w-5 h-5 rounded border-primary/30 text-action focus:ring-action"
            />
            <span class="text-sm text-primary-dark">🔔 Avisar <strong>na hora</strong> marcada</span>
          </label>
          <div>
            <label class="flex items-center gap-3 cursor-pointer">
              <input
                type="checkbox"
                name="remindBefore"
                id="remindBefore"
                class="w-5 h-5 rounded border-primary/30 text-action focus:ring-action"
              />
              <span class="text-sm text-primary-dark">⏰ Avisar <strong>antes</strong></span>
            </label>
            <select
              name="reminderMinutesBefore"
              id="reminderMinutesBefore"
              disabled
              class="mt-2 ml-8 px-3 py-2 rounded-lg border-2 border-primary/30 focus:border-action focus:ring-2 focus:ring-action/20 outline-none transition-all bg-white cursor-pointer disabled:opacity-50"
            >
              <option value="" disabled selected>Escolha o tempo</option>
              {REMINDER_OPTIONS.map((r) => (
                <option value={r.value}>{r.label}</option>
              ))}
            </select>
          </div>
        </div>
      </div>

      <!-- Seleção de Criança -->
      <div>
        <span class="block text-sm font-medium text-primary-dark mb-2">
          Atribuir à Criança
          <span class="text-action ml-1" aria-label="obrigatório">*</span>
        </span>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3" role="radiogroup">
          {children.map((child, index) => {
            const avatarColors = ['bg-primary', 'bg-secondary', 'bg-action', 'bg-highlight'];
            const getInitials = (fullName: string) => {
              const parts = fullName.trim().split(' ');
              if (parts.length >= 2) {
                return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
              }
              return fullName.slice(0, 2).toUpperCase();
            };

            return (
              <label class="relative cursor-pointer group">
                <input type="radio" name="assignedTo" value={child.id} required class="peer sr-only" />
                <div
                  class={`
                    flex flex-col items-center gap-2 p-3 md:p-4
                    rounded-xl border-2
                    transition-all duration-200
                    bg-white border-primary/20
                    peer-checked:border-action peer-checked:ring-2 peer-checked:ring-action/30
                    peer-checked:bg-surface/30
                    hover:border-action hover:shadow-md
                  `}
                >
                  <div
                    class:list={[
                      'w-12 h-12 md:w-14 md:h-14 rounded-full overflow-hidden flex items-center justify-center text-white font-bold text-lg shadow-md',
                      !child.avatar && avatarColors[index % avatarColors.length],
                    ]}
                    aria-hidden="true"
                  >
                    {child.avatar ? (
                      <img src={child.avatar} alt={child.name} class="w-full h-full object-cover" />
                    ) : (
                      <span>{getInitials(child.name)}</span>
                    )}
                  </div>
                  <span class="text-sm font-medium text-primary text-center truncate w-full">
                    {child.name}
                  </span>
                </div>
              </label>
            );
          })}
        </div>
      </div>

      <!-- Ações do Formulário -->
      <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-primary/10">
        <button
          type="submit"
          class="flex-1 px-6 py-3 bg-action hover:bg-action-dark text-white font-semibold rounded-lg shadow-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-action focus:ring-offset-2"
        >
          <span class="flex items-center justify-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 4.5v15m7.5-7.5h-15"
              />
            </svg>
            Criar Missão
          </span>
        </button>
        <button
          type="reset"
          class="px-6 py-3 bg-secondary hover:bg-secondary-dark text-white font-medium rounded-lg shadow-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-secondary focus:ring-offset-2"
        >
          Limpar
        </button>
      </div>
    </form>
  </div>

  <!-- Feedback do envio (preenchido pelo script abaixo) -->
  <div id="formFeedback" class="hidden" role="status" aria-live="polite"></div>

  <!-- Modal de sucesso no cadastro -->
  <div id="successModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-dark/60 backdrop-blur-sm">
    <div class="max-w-sm w-full mx-4 text-center bg-white rounded-2xl shadow-xl p-8">
      <div class="w-20 h-20 bg-highlight rounded-full flex items-center justify-center mx-auto mb-4 text-4xl">✅</div>
      <h2 class="text-2xl font-bold text-primary mb-1">Missão criada!</h2>
      <p id="successMessage" class="text-gray-600 mb-3"></p>
      <p class="text-sm text-gray-500">Redirecionando para Missões…</p>
    </div>
  </div>

  <!-- Script de manipulação do formulário (client-side) -->
  <script>
    import { createTask, ApiError } from '../../lib/api';
    import type { RecurrenceType, TaskFormData } from '../../lib/types';

    const form = document.getElementById('taskForm') as HTMLFormElement | null;
    const feedback = document.getElementById('formFeedback');
    const recurrenceSelect = document.getElementById('recurrenceType') as HTMLSelectElement | null;
    const recurrenceBlock = document.getElementById('recurrenceDaysBlock');
    const recurrenceDaysLabel = document.getElementById('recurrenceDaysLabel');

    // Mostra/esconde os dias da semana conforme o tipo de repetição.
    function updateRecurrenceUI() {
      if (!recurrenceSelect || !recurrenceBlock) return;
      const type = recurrenceSelect.value as RecurrenceType;
      const isRecurring = type !== 'once';
      recurrenceBlock.classList.toggle('hidden', !isRecurring);
      if (recurrenceDaysLabel) {
        const qtd = type === 'weekly' ? '1 dia' : '2 dias';
        recurrenceDaysLabel.innerHTML = `Escolha ${qtd} da semana <span class="text-action ml-1" aria-label="obrigatório">*</span>`;
      }
    }
    recurrenceSelect?.addEventListener('change', updateRecurrenceUI);
    updateRecurrenceUI();

    // Lembretes: o select de "avisar antes" só habilita se o checkbox estiver marcado.
    const remindBeforeCheck = document.getElementById('remindBefore') as HTMLInputElement | null;
    const reminderSelect = document.getElementById('reminderMinutesBefore') as HTMLSelectElement | null;
    function syncReminderSelect() {
      if (!remindBeforeCheck || !reminderSelect) return;
      reminderSelect.disabled = !remindBeforeCheck.checked;
      if (!remindBeforeCheck.checked) reminderSelect.value = '';
    }
    remindBeforeCheck?.addEventListener('change', syncReminderSelect);
    // Botão "Limpar" (reset): precisa re-desabilitar o select após o reset nativo.
    form?.addEventListener('reset', () => setTimeout(syncReminderSelect, 0));

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) return; // deixa o navegador validar os 'required'

      const fd = new FormData(form);
      const recurrenceType = String(fd.get('recurrenceType') ?? 'once') as RecurrenceType;
      const recurrenceDays = fd.getAll('recurrenceDays').map(Number);

      // Validação client-side da quantidade de dias (o backend também valida).
      const expected = recurrenceType === 'weekly' ? 1 : recurrenceType === 'twice_weekly' ? 2 : 0;
      if (recurrenceType !== 'once' && recurrenceDays.length !== expected) {
        showFeedback('error', `Para esta repetição, marque exatamente ${expected} dia(s) da semana.`);
        return;
      }

      const remindAtStart = fd.get('remindAtStart') === 'on';
      const remindBefore = fd.get('remindBefore') === 'on';
      const reminderValue = fd.get('reminderMinutesBefore');
      if (remindBefore && !reminderValue) {
        showFeedback('error', 'Escolha quantos minutos antes avisar.');
        return;
      }
      const reminderMinutesBefore = remindBefore ? Number(reminderValue) : null;

      const payload: TaskFormData = {
        title: String(fd.get('title') ?? ''),
        description: String(fd.get('description') ?? ''),
        category: String(fd.get('category') ?? '') as TaskFormData['category'],
        priority: String(fd.get('priority') ?? '') as TaskFormData['priority'],
        scheduledDate: String(fd.get('scheduledDate') ?? ''),
        scheduledTime: String(fd.get('scheduledTime') ?? ''),
        assignedTo: String(fd.get('assignedTo') ?? ''),
        estimatedDuration: String(fd.get('duration') ?? ''),
        recurrenceType,
        recurrenceDays: recurrenceType === 'once' ? [] : recurrenceDays,
        remindAtStart,
        reminderMinutesBefore,
      };

      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitButton) submitButton.disabled = true; // evita duplo clique

      try {
        const created = await createTask(payload);
        const detail = created.length > 1
          ? `${created.length} missões criadas (8 semanas)`
          : 'Missão criada com sucesso';
        showSuccessModal(detail);
        form.reset();
        updateRecurrenceUI();
      } catch (error) {
        const message = error instanceof ApiError
          ? error.message
          : 'Não foi possível criar a missão. Tente novamente.';
        showFeedback('error', message);
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });

    function showFeedback(type: 'success' | 'error', message: string) {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.className = 'mt-4 p-4 rounded-lg border text-sm font-medium ' +
        (type === 'success'
          ? 'bg-highlight/30 border-highlight text-primary-dark'
          : 'bg-action/20 border-action text-action-dark');
      feedback.classList.remove('hidden');
      feedback.setAttribute('role', type === 'error' ? 'alert' : 'status');
    }

    // Pop-up de sucesso + redirecionamento para Missões.
    function showSuccessModal(detail: string) {
      const modal = document.getElementById('successModal');
      const msg = document.getElementById('successMessage');
      if (msg) msg.textContent = detail;
      if (modal) modal.classList.remove('hidden');
      setTimeout(() => { window.location.href = '/tarefas'; }, 1500);
    }
  </script>
</section>
