---
/**
 * Componente de textarea reutilizável
 */
interface Props {
  name: string;
  label?: string;
  placeholder?: string;
  required?: boolean;
  disabled?: boolean;
  rows?: number;
  class?: string;
  error?: string;
  id?: string;
}

const {
  name,
  label,
  placeholder,
  required = false,
  disabled = false,
  rows = 4,
  class: extraClass = '',
  error,
  id: customId,
} = Astro.props;

const inputId = customId || name;

const textareaClass = `
  w-full px-4 py-3
  rounded-lg border-2
  bg-white
  text-base
  transition-all duration-200
  focus:outline-none
  ${error ? 'border-action' : 'border-primary/30 focus:border-primary'}
  focus:ring-2 focus:ring-primary/20
  disabled:bg-surface/50 disabled:cursor-not-allowed
  resize-y
  ${extraClass}
`.trim();
---

<div class="flex flex-col gap-1.5">
  {label && (
    <label for={inputId} class="text-sm font-medium text-primary-dark">
      {label}
      {required && <span class="text-action ml-1" aria-label="obrigatório">*</span>}
    </label>
  )}
  <textarea
    id={inputId}
    name={name}
    placeholder={placeholder}
    required={required}
    disabled={disabled}
    rows={rows}
    class={textareaClass}
    aria-invalid={error ? 'true' : 'false'}
    aria-describedby={error ? `${inputId}-error` : undefined}
  ></textarea>
  {error && (
    <p id={`${inputId}-error`} class="text-sm text-action font-medium" role="alert">
      {error}
    </p>
  )}
</div>
