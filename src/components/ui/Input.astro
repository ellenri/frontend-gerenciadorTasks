---
/**
 * Componente de input de texto reutilizável
 */
interface Props {
  name: string;
  type?: 'text' | 'email' | 'password' | 'tel' | 'date' | 'time' | 'number';
  label?: string;
  placeholder?: string;
  required?: boolean;
  disabled?: boolean;
  value?: string;
  min?: string;
  max?: string;
  class?: string;
  error?: string;
  id?: string;
}

const {
  name,
  type = 'text',
  label,
  placeholder,
  required = false,
  disabled = false,
  value,
  min,
  max,
  class: extraClass = '',
  error,
  id: customId,
} = Astro.props;

const inputId = customId || name;

const inputClass = `
  w-full px-4 py-3
  rounded-lg border-2
  bg-white
  text-base
  transition-all duration-200
  focus:outline-none
  ${error ? 'border-action' : 'border-primary/30 focus:border-primary'}
  focus:ring-2 focus:ring-primary/20
  disabled:bg-surface/50 disabled:cursor-not-allowed
  ${extraClass}
`.trim();
---

<div class="flex flex-col gap-1.5">
  {label && (
    <label for={inputId} class="text-sm font-medium text-primary-dark">
      {label}
      {required && <span class="text-action ml-1" aria-label="obrigatório">*</span>}
    </label>
  )}
  <input
    type={type}
    id={inputId}
    name={name}
    placeholder={placeholder}
    required={required}
    disabled={disabled}
    value={value}
    min={min}
    max={max}
    class={inputClass}
    aria-invalid={error ? 'true' : 'false'}
    aria-describedby={error ? `${inputId}-error` : undefined}
  />
  {error && (
    <p id={`${inputId}-error`} class="text-sm text-action font-medium" role="alert">
      {error}
    </p>
  )}
</div>
