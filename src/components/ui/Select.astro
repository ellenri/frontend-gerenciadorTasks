---
/**
 * Componente de select reutilizável
 */
interface Props {
  name: string;
  label?: string;
  required?: boolean;
  disabled?: boolean;
  placeholder?: string;
  options: Array<{ value: string; label: string }>;
  class?: string;
  error?: string;
  id?: string;
}

const {
  name,
  label,
  required = false,
  disabled = false,
  placeholder = 'Selecione...',
  options,
  class: extraClass = '',
  error,
  id: customId,
} = Astro.props;

const inputId = customId || name;

const selectClass = `
  w-full px-4 py-3
  rounded-lg border-2
  bg-white
  text-base
  transition-all duration-200
  focus:outline-none
  ${error ? 'border-action' : 'border-primary/30 focus:border-primary'}
  focus:ring-2 focus:ring-primary/20
  disabled:bg-surface/50 disabled:cursor-not-allowed
  cursor-pointer
  ${extraClass}
`.trim();
---

<div class="flex flex-col gap-1.5">
  {label && (
    <label for={inputId} class="text-sm font-medium text-primary-dark">
      {label}
      {required && <span class="text-action ml-1" aria-label="obrigatório">*</span>}
    </label>
  )}
  <select
    id={inputId}
    name={name}
    required={required}
    disabled={disabled}
    class={selectClass}
    aria-invalid={error ? 'true' : 'false'}
    aria-describedby={error ? `${inputId}-error` : undefined}
  >
    <option value="" disabled selected>
      {placeholder}
    </option>
    {options.map((option) => (
      <option value={option.value}>{option.label}</option>
    ))}
  </select>
  {error && (
    <p id={`${inputId}-error`} class="text-sm text-action font-medium" role="alert">
      {error}
    </p>
  )}
</div>
