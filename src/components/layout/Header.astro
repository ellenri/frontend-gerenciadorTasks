---
import { getUnreadNotificationCount } from '@/lib/api';

/**
 * Cabeçalho principal (responsivo). Recebe o usuário autenticado (se houver)
 * e, quando logado, mostra o sininho com o contador de não-lidas.
 */
interface Props {
  user?: { fullName: string } | null;
}

const { user = null } = Astro.props;

let unreadCount = 0;
if (user) {
  try {
    unreadCount = await getUnreadNotificationCount(Astro.request.headers.get('cookie') ?? '');
  } catch {
    unreadCount = 0;
  }
}
---

<header class="bg-primary text-white shadow-lg">
  <nav class="container mx-auto px-4 py-3" aria-label="Navegação principal">
    <div class="flex items-center justify-between">
      <!-- Logo / ícone de home -->
      <a href="/" aria-label="Zapt — Início" class="flex items-center shrink-0">
        <img src="/zapt/nav_bar.png" alt="Zapt" class="h-10 md:h-12 w-auto rounded-lg" />
      </a>

      <!-- Links de Navegação + Área do usuário -->
      <ul class="flex items-center gap-2 md:gap-4">
        <li>
          <a
            href="/cadastro-tarefas"
            class="px-3 py-2 md:px-4 md:py-2 rounded-lg bg-action hover:bg-action-dark transition-colors text-sm md:text-base font-medium"
          >
            Nova Missão
          </a>
        </li>
        <li>
          <a
            href="/tarefas"
            class="px-3 py-2 md:px-4 md:py-2 rounded-lg hover:bg-primary-dark transition-colors text-sm md:text-base font-medium"
          >
            Missões
          </a>
        </li>
        <li>
          <a
            href="/recompensas"
            class="px-3 py-2 md:px-4 md:py-2 rounded-lg hover:bg-primary-dark transition-colors text-sm md:text-base font-medium"
          >
            Recompensas
          </a>
        </li>
        <li>
          <a
            href="/ranking"
            class="px-3 py-2 md:px-4 md:py-2 rounded-lg bg-highlight hover:bg-highlight-dark text-primary transition-colors text-sm md:text-base font-medium"
          >
            🏆 Ranking
          </a>
        </li>
        <li>
          <a
            href="/cadastro-criancas"
            class="px-3 py-2 md:px-4 md:py-2 rounded-lg hover:bg-primary-dark transition-colors text-sm md:text-base font-medium"
          >
            + Criança
          </a>
        </li>

        <!-- Usuário: logado mostra Sair; anônimo mostra Entrar -->
        <li
          class:list={[
            'flex items-center gap-2 ml-1 pl-2 md:pl-3',
            { 'border-l border-white/30': true },
          ]}
        >
          {
            user ? (
              <>
                <a
                  href="/notificacoes"
                  class="relative px-3 py-2 rounded-lg hover:bg-primary-dark transition-colors"
                  title="Notificações"
                  aria-label="Notificações"
                >
                  🔔
                  {unreadCount > 0 && (
                    <span class="absolute -top-1 -right-1 bg-action text-white text-xs font-bold rounded-full min-w-[1.25rem] h-5 flex items-center justify-center px-1">
                      {unreadCount}
                    </span>
                  )}
                </a>
                <span class="hidden md:inline text-sm text-surface-light truncate max-w-[10rem]">
                  Olá, {user.fullName}
                </span>
                <button
                  id="logout-btn"
                  type="button"
                  class="px-3 py-2 rounded-lg bg-action hover:bg-action-dark text-sm font-medium transition-colors"
                >
                  Sair
                </button>
              </>
            ) : (
              <a
                href="/login"
                class="px-3 py-2 rounded-lg bg-action hover:bg-action-dark text-sm font-medium transition-colors"
              >
                Entrar
              </a>
            )
          }
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  import { logout } from '../../lib/api';

  const btn = document.getElementById('logout-btn');
  btn?.addEventListener('click', async () => {
    btn.setAttribute('disabled', 'true');
    btn.textContent = 'Saindo...';
    try {
      await logout();
    } catch {
      // mesmo com erro, volta para o login
    }
    window.location.href = '/login';
  });
</script>

<style>
  a,
  button {
    transition: background-color 0.2s ease-in-out;
  }
</style>
